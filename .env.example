VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL of this quote/booking app (used in offer emails). Example: https://your-app.vercel.app
# Booking links use /boka/{token} (not ?bookingToken= in the query string).
VITE_BOOKING_PAGE_URL=

# Supabase Edge Function secret (Dashboard → Edge Functions → Secrets), same URL as above:
# BOOKING_PAGE_URL=https://quote-calculator-teal.vercel.app
# Optional: extra allowed hosts (comma-separated) for booking links in emails:
# BOOKING_PAGE_ALLOWED_HOSTS=preview.example.com
# Booking link validity in offer emails (days):
# BOOKING_TOKEN_TTL_DAYS=30

# Optional: only for `supabase db pull`, psql, DBeaver, etc. (not used by the Vite app or Edge Functions).
# Set to the same value as Supabase Dashboard → Settings → Database → Database password.
SUPABASE_DB_PASSWORD=
